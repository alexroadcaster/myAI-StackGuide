{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai-stackguide.invalid/contracts/v2/retrieval/retrieval-result.schema.json",
  "title": "Compact retrieval candidates with explicit failure state",
  "description": "Local CP-03-C9-V2 contract. This schema does not execute or authorize side effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "query_id",
    "query_sha256",
    "brief_version",
    "source_mode",
    "retrieval_engine",
    "pins",
    "status",
    "executed_variants",
    "retrieved_hits",
    "candidates",
    "truncated",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "run_id": {
      "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/uuid"
    },
    "query_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "query_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "brief_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "source_mode": {
      "const": "catalog_only"
    },
    "retrieval_engine": {
      "const": "sqlite_fts5"
    },
    "pins": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_snapshot_id",
            "source_sha256",
            "cards_sha256",
            "index_sha256",
            "policy_sha256",
            "taxonomy_sha256",
            "card_schema_version",
            "activity_schema_version",
            "index_format_version",
            "retrieval_policy_version",
            "corpus_kind"
          ],
          "properties": {
            "catalog_snapshot_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            },
            "source_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "cards_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "index_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "policy_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "taxonomy_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "card_schema_version": {
              "const": "2.0.0"
            },
            "activity_schema_version": { "const": "2.0.0" },
            "index_format_version": {
              "const": 2
            },
            "retrieval_policy_version": {
              "const": "2.0.0"
            },
            "corpus_kind": {
              "enum": [
                "catalog_snapshot",
                "synthetic_fixture"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ok",
        "no_match",
        "retrieval_unavailable",
        "index_incompatible",
        "invalid_query",
        "cancelled"
      ]
    },
    "executed_variants": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "retrieved_hits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "github_repository_id",
          "rank",
          "rrf_score",
          "variant_ranks",
          "matched_fields",
          "missing_facts"
        ],
        "properties": {
          "github_repository_id": {
            "type": "integer",
            "minimum": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "rrf_score": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "variant_ranks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variant_id",
                "rank",
                "bm25"
              ],
              "properties": {
                "variant_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24,
                  "pattern": "^q[1-3]$"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "bm25": {
                  "type": "number",
                  "maximum": 0
                }
              }
            },
            "maxItems": 3,
            "minItems": 1
          },
          "matched_fields": {
            "type": "array",
            "items": {
              "enum": [
                "full_name",
                "full_name_aliases",
                "upstream_description",
                "catalog_description",
                "topics",
                "category_labels",
                "use_cases",
                "integration_surface",
                "best_for"
              ]
            },
            "maxItems": 9,
            "minItems": 1,
            "uniqueItems": true
          },
          "missing_facts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 20,
            "minItems": 0,
            "uniqueItems": true
          }
        }
      },
      "maxItems": 60,
      "minItems": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "constraint_mismatch",
          "mandatory_fact_unknown",
          "archived",
          "unavailable",
          "duplicate_identity",
          "insufficient_evidence",
          "context_budget",
          "candidate_budget",
          "invalid_query",
          "fts5_unavailable",
          "index_missing",
          "index_corrupt",
          "index_incompatible",
          "no_hits",
          "cancelled"
        ]
      },
      "maxItems": 12,
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "minItems": 1
          },
          "executed_variants": {
            "minimum": 1
          },
          "retrieved_hits": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "ok"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "maxItems": 0
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "no_match"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "pins": {
            "type": "object"
          }
        }
      }
    }
  ],
  "x-max-utf8-bytes": 65536,
  "x-invariants": [
    "Pins exactly match the loaded v2 manifest/policy and request; card/activity/policy/index versions, IDs/revisions and canonical query digest must match.",
    "Rank is contiguous after numeric GitHub identity dedupe; variant ranks refer to executed query variants; RRF is sum(1/(60+rank)), sorted descending with numeric ID tie-break. No-match cannot conceal index/FTS5 failure.",
    "An unavailable manifest may yield pins=null only in an explicit failure. Never invent hashes or use null pins for successful retrieval/no-match."
  ]
}
