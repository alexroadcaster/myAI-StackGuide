{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_set_sha256",
    "evidence_kind",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "retrieval_captures_v1"
    },
    "case_set_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_kind": {
      "const": "synthetic_contract_capture"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "retrieval",
          "evidence_pack",
          "measurements"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "retrieval": {
            "$ref": "https://myai-stackguide.invalid/contracts/v1/retrieval/retrieval-result.schema.json"
          },
          "evidence_pack": {
            "$ref": "https://myai-stackguide.invalid/contracts/v1/retrieval/evidence-pack.schema.json"
          },
          "measurements": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "serialization",
              "evidence_pack_bytes",
              "brief_bytes",
              "targeted_context_bytes",
              "request_bytes",
              "plugin_input_bytes",
              "latency_ms",
              "latency_method",
              "peak_memory_bytes",
              "memory_method",
              "input_tokens",
              "tokenizer"
            ],
            "properties": {
              "serialization": {
                "const": "sorted_keys_compact_json_ensure_ascii_false_allow_nan_false"
              },
              "evidence_pack_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 49152
              },
              "brief_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "targeted_context_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "request_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "plugin_input_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 90112
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latency_ms": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "latency_method": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "peak_memory_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1099511627776
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "memory_method": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "input_tokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tokenizer": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai-stackguide.invalid/contracts/v1/evals/result.schema.json",
  "title": "C8 synthetic captures of the actual C9 result and evidence pack",
  "x-max-utf8-bytes": 2097152
}
