{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai-stackguide.invalid/contracts/v1/intake/intake-state.schema.json",
  "title": "Bounded resumable interview",
  "description": "CP-03 local contract. Version 1.0.0 is a retained read-only legacy shape; new writes use 1.1.0. No migration or runtime is implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "questions_asked",
    "answers",
    "pending_question_id",
    "next_action",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "run_id": {
      "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/uuid"
    },
    "status": {
      "enum": [
        "asking",
        "ready",
        "cancelled"
      ]
    },
    "questions_asked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "answers": {
      "type": "array",
      "items": {
        "$ref": "https://myai-stackguide.invalid/contracts/v1/intake/interview-answer.schema.json"
      },
      "maxItems": 10,
      "minItems": 0
    },
    "pending_question_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_action": {
      "enum": [
        "answer_question",
        "review_context",
        "proceed_with_assumptions",
        "clarification_required",
        "resume_or_finalize"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "maxItems": 12,
      "minItems": 0,
      "uniqueItems": true
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "ordinal",
          "text",
          "rationale",
          "decision_consequence",
          "answer_examples",
          "topics"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "decision_consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "answer_examples": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "maxItems": 3,
            "minItems": 0
          },
          "topics": {
            "type": "array",
            "items": {
              "enum": [
                "goal",
                "deployment",
                "stack",
                "license_data",
                "integration"
              ]
            },
            "maxItems": 5,
            "minItems": 1
          }
        }
      },
      "maxItems": 10,
      "minItems": 0
    },
    "completion_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "pending_question_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "questions",
          "completion_reason"
        ],
        "properties": {
          "answers": {
            "items": {
              "properties": {
                "schema_version": {
                  "const": "1.1.0"
                }
              }
            }
          },
          "next_action": {
            "enum": [
              "answer_question",
              "review_context",
              "proceed_with_assumptions",
              "resume_or_finalize"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "asking"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "pending_question_id": {
                  "type": "string"
                },
                "next_action": {
                  "const": "answer_question"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "answers": {
                  "minItems": 1
                },
                "completion_reason": {
                  "type": "string"
                },
                "next_action": {
                  "enum": [
                    "review_context",
                    "proceed_with_assumptions"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "cancelled"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "next_action": {
                  "const": "resume_or_finalize"
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "answers": {
            "items": {
              "properties": {
                "schema_version": {
                  "const": "1.0.0"
                }
              }
            }
          },
          "questions": false,
          "completion_reason": false,
          "next_action": {
            "enum": [
              "answer_question",
              "review_context",
              "proceed_with_assumptions",
              "clarification_required",
              "resume_or_finalize"
            ]
          }
        }
      }
    }
  ],
  "x-invariants": [
    "questions_asked equals unique answered/skipped questions plus any pending question; ordinals are contiguous from 1. Corrections replace an answer version without increasing unique question count.",
    "New 1.1.0 intake starts asking with exactly one pending question at ordinal 1. ready may occur before ten questions only after at least one accepted answer; cancellation never fabricates answers. Retained 1.0.0 state keeps its read-only legacy interpretation.",
    "Questions are the canonical bounded question ledger, not chat. Question IDs/ordinals join saved answers and pending_question_id exactly; no saved answer exists without its question.",
    "Every answer in intake 1.1.0 uses interview-answer 1.1.0 and its bounded last_correction_id; retained intake 1.0.0 answers remain 1.0.0 and cannot gain the marker. No correction ledger or prior answer value is stored.",
    "Topic coverage is derived from answered/skipped/pending question joins, never a completion percentage. For 1.1.0, ready requires completion_reason and asking requires a pending question; no state asks an eleventh question.",
    "The persisted intake next_action vocabulary is unchanged: asking with a pending question maps to answer_question; retained zero-question compatibility maps to clarification_required; ready maps to review_context or, when assumptions are retained, proceed_with_assumptions; cancelled maps to resume_or_finalize. Runtime phase advancement is derived from lifecycle, phase and legal commands, not new intake next_action literals. Once a memo exists, memo.next_action owns the user-facing next action."
  ]
}
