{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai-stackguide.invalid/contracts/v1/recommendation/recommendation-request.schema.json",
  "title": "Model decision input references and explicit action boundary",
  "description": "Local CP-03 v1 contract. This schema does not execute or authorize side effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "brief_id",
    "brief_version",
    "query",
    "pack_id",
    "output_intent",
    "execution_authorized_by_this_request",
    "input_allocation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/uuid"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "brief_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "query": {
      "$ref": "https://myai-stackguide.invalid/contracts/v2/retrieval/catalog-query.schema.json"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "output_intent": {
      "enum": [
        "decision_report",
        "integration_handoff"
      ]
    },
    "execution_authorized_by_this_request": {
      "const": false
    },
    "input_allocation": {
      "const": {
        "brief_bytes": 16384,
        "targeted_context_bytes": 16384,
        "evidence_bytes": 49152,
        "request_bytes": 8192,
        "plugin_input_bytes": 90112
      }
    }
  },
  "x-max-utf8-bytes": 8192
}
