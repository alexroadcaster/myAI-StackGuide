{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myai-stackguide.invalid/contracts/v1/scanner/scanner-restart-checkpoint.schema.json",
  "title": "Private scanner restart checkpoint",
  "description": "Noncanonical CP-07/CP-08 local restart sidecar. It is private plugin-owned state, never public catalog data, canonical session state, renderer input or model context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner_marker",
    "checkpoint_id",
    "run_id",
    "root_ref",
    "root_fingerprint",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "expected_state_revision",
    "committed_state_revision",
    "mode",
    "last_report",
    "session"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "owner_marker": {
      "const": "myai-stackguide.scan-checkpoint.v1"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^checkpoint-[a-f0-9]{32}$"
    },
    "run_id": {
      "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/uuid"
    },
    "root_ref": {
      "const": "selected-project"
    },
    "root_fingerprint": {
      "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/sha256"
    },
    "policy_id": {
      "const": "local-scan-v1.3"
    },
    "policy_version": {
      "const": "1.3.0"
    },
    "policy_sha256": {
      "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/sha256"
    },
    "expected_state_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "committed_state_revision": {
      "type": "integer",
      "minimum": 2,
      "maximum": 1000000
    },
    "mode": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "last_report": {
      "$ref": "https://myai-stackguide.invalid/contracts/v1/scanner/scan-report.schema.json"
    },
    "session": {
      "$ref": "#/$defs/session"
    }
  },
  "$defs": {
    "pathOrRoot": {
      "anyOf": [
        {
          "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/relativePath"
        },
        {
          "const": ""
        }
      ]
    },
    "pathList": {
      "type": "array",
      "items": {
        "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/relativePath"
      },
      "maxItems": 1000000,
      "minItems": 0,
      "uniqueItems": true
    },
    "directoryCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "depth"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/pathOrRoot"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        }
      }
    },
    "candidateFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "size_bytes",
        "kind"
      ],
      "properties": {
        "relative_path": {
          "$ref": "https://myai-stackguide.invalid/contracts/v1/context/sanitized-project-summary.schema.json#/$defs/relativePath"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "kind": {
          "enum": [
            "manifest",
            "document",
            "source"
          ]
        }
      }
    },
    "fileRecord": {
      "$ref": "https://myai-stackguide.invalid/contracts/v1/scanner/scan-manifest.schema.json#/properties/files/items"
    },
    "checkpointCounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_attempts",
        "bytes_consumed",
        "elapsed_ms"
      ],
      "properties": {
        "file_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "bytes_consumed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      }
    },
    "quickLimitOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 2000},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "topology_max_entries": {"type": "integer", "minimum": 1, "maximum": 50000},
        "topology_max_depth": {"type": "integer", "minimum": 1, "maximum": 20},
        "topology_max_seconds": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "context_max_files": {"type": "integer", "minimum": 1, "maximum": 16},
        "context_max_read_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "context_max_model_context_bytes": {"type": "integer", "minimum": 1, "maximum": 24576}
      }
    },
    "standardLimitOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 30000},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 1200},
        "topology_max_entries": {"type": "integer", "minimum": 1, "maximum": 250000},
        "topology_max_depth": {"type": "integer", "minimum": 1, "maximum": 40},
        "topology_max_seconds": {"type": "integer", "minimum": 1, "maximum": 90},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
        "context_max_files": {"type": "integer", "minimum": 1, "maximum": 64},
        "context_max_read_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "context_max_model_context_bytes": {"type": "integer", "minimum": 1, "maximum": 49152}
      }
    },
    "deepLimitOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 4000},
        "topology_max_entries": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "topology_max_depth": {"type": "integer", "minimum": 1, "maximum": 50},
        "topology_max_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "context_max_files": {"type": "integer", "minimum": 1, "maximum": 256},
        "context_max_read_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "context_max_model_context_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending_dirs",
        "depth_deferred",
        "candidate_files",
        "records",
        "read_paths",
        "excluded_counts",
        "oversized",
        "service_root_count",
        "workspace_declared",
        "reasons",
        "warnings",
        "checkpoints",
        "last_checkpoint_files",
        "last_checkpoint_bytes",
        "visited_entries",
        "file_attempts",
        "bytes_consumed",
        "active_seconds",
        "topology_seconds",
        "topology_complete",
        "limit_overrides"
      ],
      "properties": {
        "pending_dirs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directoryCursor"
          },
          "maxItems": 1000000,
          "minItems": 0
        },
        "depth_deferred": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directoryCursor"
          },
          "maxItems": 1000000,
          "minItems": 0
        },
        "candidate_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidateFile"
          },
          "maxItems": 1000000,
          "minItems": 0
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileRecord"
          },
          "maxItems": 1000000,
          "minItems": 0
        },
        "read_paths": {
          "$ref": "#/$defs/pathList"
        },
        "excluded_counts": {
          "$ref": "https://myai-stackguide.invalid/contracts/v1/scanner/scan-manifest.schema.json#/properties/excluded_counts"
        },
        "oversized": {
          "$ref": "#/$defs/pathList"
        },
        "service_root_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "workspace_declared": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "https://myai-stackguide.invalid/contracts/v1/scanner/scan-report.schema.json#/properties/reason_codes/items"
          },
          "maxItems": 16,
          "minItems": 0,
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "enum": [
              "files_80_percent",
              "bytes_80_percent",
              "time_80_percent",
              "topology_entries_80_percent",
              "topology_time_80_percent"
            ]
          },
          "maxItems": 5,
          "minItems": 0,
          "uniqueItems": true
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkpointCounter"
          },
          "maxItems": 10000,
          "minItems": 0
        },
        "last_checkpoint_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "last_checkpoint_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "visited_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "file_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "bytes_consumed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "active_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "topology_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "topology_complete": {
          "type": "boolean"
        },
        "limit_overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quick": {"$ref": "#/$defs/quickLimitOverride"},
            "standard": {"$ref": "#/$defs/standardLimitOverride"},
            "deep": {"$ref": "#/$defs/deepLimitOverride"}
          },
          "maxProperties": 3
        }
      }
    }
  },
  "x-max-utf8-bytes": 67108864,
  "x-invariants": [
    "checkpoint_id is checkpoint- plus the first 32 lowercase hexadecimal characters of SHA-256 over compact canonical UTF-8 JSON for every top-level field except checkpoint_id.",
    "committed_state_revision is expected_state_revision plus one. last_report run_id, mode and policy_version equal the checkpoint values.",
    "root_fingerprint is SHA-256 over run_id, a NUL delimiter and the normalized selected root identity. It binds the private root without persisting an absolute path; policy_sha256 binds the exact effective policy.",
    "The sidecar is valid only for the same owner, run, selected root, policy and current committed state revision. Any mismatch, malformed file or stale/orphaned sidecar fails closed and is never merged into canonical state.",
    "No source text, excerpts, absolute paths, raw topology graph, excluded/sensitive path lists, credentials or chat are admitted. excluded_counts are aggregate categories only. On restore topology is deliberately incomplete and must be rebuilt before topology-complete claims.",
    "This checkpoint is noncanonical restart state. It never enters state.json, finalized history, HTML/public output, retrieval or model context."
  ]
}
